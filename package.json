{
  "name": "autodocs",
  "version": "1.0.0",
  "description": "Automatically generate documentation for React components using AI",
  "type": "module",
  "scripts": {
    "autodocs": "tsx scripts/autodocs/cli/index.ts",
    "autodocs:watch": "tsx scripts/autodocs/cli/index.ts generate --watch",
    "autodocs:full": "tsx scripts/autodocs/cli/index.ts generate",
    "autodocs:validate": "tsx scripts/autodocs/cli/index.ts generate --validate",
    "autodocs:cache": "tsx scripts/autodocs/cli/index.ts cache --stats",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@types/node": "^20.14.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "cosmiconfig": "^9.0.0",
    "glob": "^10.4.0",
    "handlebars": "^4.7.8",
    "ora": "^8.0.1",
    "simple-git": "^3.25.0",
    "ts-morph": "^23.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "documentation",
    "react",
    "components",
    "ai",
    "automation"
  ],
  "license": "MIT"
}
